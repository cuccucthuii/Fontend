# Social Login Configuration
# Copy this file to .env and fill in your actual credentials

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/
# 1. Create new project or select existing
# 2. Enable Google+ API
# 3. Create OAuth 2.0 credentials
# 4. Add authorized redirect URI: http://localhost:5173/auth/google/callback
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here

# Facebook OAuth Configuration  
# Get from: https://developers.facebook.com/
# 1. Create new app
# 2. Add Facebook Login product
# 3. Add valid OAuth redirect URI: http://localhost:5173/auth/facebook/callback
VITE_FACEBOOK_APP_ID=your-facebook-app-id-here

# API Base URL
VITE_API_BASE_URL=http://localhost:3000

# Environment
VITE_NODE_ENV=development

# Example values (replace with your actual credentials):
# VITE_GOOGLE_CLIENT_ID=123456789-abcdefghijklmnop.apps.googleusercontent.com
# VITE_FACEBOOK_APP_ID=1234567890123456
